# Source maps are 24 MB — larger than everything else in the build combined.
# Browsers only fetch them when devtools is open, but they are still uploaded
# on every deploy. The source is public on GitHub, so nothing is gained by
# shipping them.
GENERATE_SOURCEMAP=false

# CRA treats warnings as errors when CI is set, which breaks deploys on a
# stray unused import. Linting runs as its own step instead.
CI=false
